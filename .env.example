# Rockstat single-host deployment config.
# Copy to .env and adjust for the host.
#
# NOTE: avoid `$` in values — docker compose interpolates .env files.

# ===== Host / identity =====
DOMAIN=example.com
FULLNAME="Aldous Huxley"
EMAIL=hello@example.com
TZ=UTC
LOG_LEVEL=info

# uid/gid owning data dirs (ansible: _uid/_gid)
PUID=472
PGID=472

# ===== Docker networks =====
# main platform network (bridge name = network name)
DOCKER_NET_NAME=custom
DOCKER_NET=172.16.25.0/24
# gateway of the main network; inner services bind ports on it (ansible: if_inner)
BIND_IP=172.16.25.1
# devtools network
DOCKER_DEV_NET_NAME=dev
DOCKER_DEV_NET=172.16.26.0/24

# ===== Host paths =====
# Everything lives inside the project folder by default (relative to this
# directory). For hosts migrated from ansible point these to the old layout
# (/srv/platform/data, /srv/platform/etc, /srv/clickhouse, /srv/redis, ...).
DATA_DIR=./data
ETC_DIR=./etc
CLICKHOUSE_DATA_DIR=./data/clickhouse
CLICKHOUSE_TMP_DIR=./data/clickhouse_tmp
CLICKHOUSE_LOG_DIR=./data/clickhouse_log
REDIS_DATA_DIR=./data/redis

# ===== TLS =====
# Certificates for nginx are obtained automatically by certbot into
# $DATA_DIR/certbot/conf (./deploy.sh cert-init). chproxy/caddy reuse the
# same files; ${DOMAIN} and ${DATA_DIR} are substituted from the values above,
# so normally these two lines need no editing.
SSL_CERT=${DATA_DIR}/certbot/conf/live/${DOMAIN}/fullchain.pem
SSL_CERT_KEY=${DATA_DIR}/certbot/conf/live/${DOMAIN}/privkey.pem
# 1 = use Let's Encrypt staging CA for cert-init (testing)
LETSENCRYPT_STAGING=0

# ===== ClickHouse =====
# 1 = ClickHouse runs locally in this compose (container, configs, create-db)
# 0 = external ClickHouse: set CLICKHOUSE_HOST/CLICKHOUSE_HTTP_PORT to the
#     external server, local container is not started
CLICKHOUSE_LOCAL=1
# for local setup keep CLICKHOUSE_HOST equal to BIND_IP
CLICKHOUSE_HOST=172.16.25.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_RO_USER=readonly
CLICKHOUSE_RO_PASSWORD=readonly
CLICKHOUSE_DB=stats
# limits for the local container (used only when CLICKHOUSE_LOCAL=1);
# size to the host: ~50-70% of RAM (preflight warns if it exceeds total RAM)
MEM_LIMIT_CLICKHOUSE=32g
CPUS_CLICKHOUSE=4
MEM_LIMIT_REDIS=5g

# ===== Front =====
# number of front workers (each gets its own WORKER_ID and host port)
FRONT_SCALE=5
# worker i listens on BIND_IP:(FRONT_PORT_BASE + 2*i)
FRONT_PORT_BASE=10001

# ===== Kafka =====
KAFKA_BROKERS=

# ===== Telegraf -> InfluxDB =====
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# ===== Devtools =====
CADDY_PORT=2083
UI_PASSWORD=
UI_SECRET=
UI_PROJECTS=
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com

# ===== Images =====
IMAGE_FRONT=rockstat/front:ng
IMAGE_CHWRITER=rockstat/chwriter:ng
IMAGE_KAFKASTREAM=rockstat/kafkastream:ng
IMAGE_CHPROXY=contentsquareplatform/chproxy:v1.24.0-amd64
IMAGE_REDIS=redis:7-alpine
IMAGE_CLICKHOUSE=clickhouse/clickhouse-server:26.9.13.15
IMAGE_CADDY=lucaslorentz/caddy-docker-proxy:ci-alpine
IMAGE_JUPYTER=quay.io/jupyter/scipy-notebook:2024-01-15
IMAGE_GRAFANA=grafana/grafana-oss
IMAGE_TELEGRAF=telegraf
IMAGE_MMGEO=rockstat/mmgeo_typescript:ng
IMAGE_UI=rockstat/ui:latest
IMAGE_NGINX=nginx:1.27-alpine
IMAGE_CERTBOT=certbot/certbot
