<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <!-- Profile that allows only read queries. -->
        <default>
            <allow_deprecated_syntax_for_merge_tree>1</allow_deprecated_syntax_for_merge_tree>
        </default>
        <readonly>
            <readonly>1</readonly>
            <max_threads>4</max_threads>
        </readonly>
    </profiles>
    <users>
        <default>
            <password>${CLICKHOUSE_PASSWORD}</password>
            <profile>default</profile>
            <quota>default</quota>
        </default>
        <readonly>
            <password>${CLICKHOUSE_RO_PASSWORD}</password>
            <networks incl="networks" replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
                <ip>172.16.0.0/16</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
        </readonly>
    </users>
</clickhouse>
